# Server Configuration
# The port the Node.js server will listen on.
PORT=3001

# The environment the application is running in (e.g., development, production).
NODE_ENV=development

# The origin allowed for CORS requests. This should match your client's URL in production.
# For development, it's typically the React app's default port (3000).
CORS_ORIGIN=http://localhost:3000

# Path to the JSON file used for data persistence.
# This path is relative to the server's root directory.
DATA_FILE_PATH=./data/tasks.json

# --- Cross-Service API Endpoints (for potential server-to-server communication) ---
# These URLs would point to other services in a microservice architecture.
# Uncomment and configure if your To-Do List backend needs to interact with them.

# RECIPE_CONVERTER_API_URL=http://localhost:4001/api/convert
# WEATHER_DASHBOARD_API_URL=http://localhost:4002/api/weather
# URL_SHORTENER_API_URL=http://localhost:4003/api/shorten
# ECOMMERCE_CATALOG_API_URL=http://localhost:4004/api/products
# AI_ASSISTANT_API_URL=http://localhost:4005/api/ai
# BLOG_PLATFORM_API_URL=http://localhost:4006/api/posts


# Client Configuration (React App)
# Variables prefixed with REACT_APP_ are exposed to the client-side React application.

# The base URL for the backend API that the React client will connect to.
# This should match the server's address and port.
REACT_APP_API_BASE_URL=http://localhost:3001/api

# --- Cross-Service Client-Facing URLs (for potential client-side navigation or integration) ---
# These URLs would be used by the React client to link to or interact with other services.
# Uncomment and configure if your To-Do List client needs to reference them.

# REACT_APP_RECIPE_CONVERTER_URL=http://localhost:3002
# REACT_APP_WEATHER_DASHBOARD_URL=http://localhost:3003
# REACT_APP_URL_SHORTENER_URL=http://localhost:3004
# REACT_APP_ECOMMERCE_CATALOG_URL=http://localhost:3005
# REACT_APP_AI_ASSISTANT_URL=http://localhost:3006
# REACT_APP_BLOG_PLATFORM_URL=http://localhost:3007